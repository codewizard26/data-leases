# Local development ports; services are not implemented yet
WEB_PORT=3000
GATEWAY_PORT=4100
PROVIDER_A_PORT=4101
PROVIDER_B_PORT=4102
VERIFICATION_MODE=MOCK
PAYMENTS_ENABLED=false

# Optional advisory inference. Default mock requires no credentials.
COMPUTE_PROVIDER=mock
# 0G Direct provider endpoint from catalog (HTTPS, path /v1/proxy)
ZERO_G_BASE_URL=
ZERO_G_MODEL=
# Provider-scoped app-sk secret; never commit real values.
ZERO_G_API_KEY=

# OpenRouter free models; credentials stay server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
