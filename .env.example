# Local development ports; services are not implemented yet
WEB_PORT=3000
GATEWAY_PORT=4100
PROVIDER_A_PORT=4101
PROVIDER_B_PORT=4102
VERIFICATION_MODE=MOCK
PAYMENTS_ENABLED=false

# Optional advisory inference. Default mock requires no credentials.
COMPUTE_PROVIDER=mock
# 0G Direct provider endpoint from catalog (HTTPS, path /v1/proxy)
ZERO_G_BASE_URL=
ZERO_G_MODEL=
# Provider-scoped app-sk secret; never commit real values.
ZERO_G_API_KEY=

# OpenRouter free models; credentials stay server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=recursive/flint-v1.0:free

# Choose Mock or Live per run in the browser. Live requires a configured compute provider.

# Hedera x402 v2 exact payments. Testnet only; never reuse real-funds keys.
# HBAR uses tinybars: 1 HBAR = 100000000 tinybars. No USD conversion occurs.
HEDERA_NETWORK=hedera:testnet
HEDERA_BUYER_ACCOUNT_ID=
HEDERA_BUYER_EVM_ADDRESS=
HEDERA_BUYER_PRIVATE_KEY=
HEDERA_BUYER_KEY_TYPE=ECDSA
HEDERA_PROVIDER_A_ACCOUNT_ID=
HEDERA_PROVIDER_B_ACCOUNT_ID=
# Choose your own explicit positive per-payment limit before enabling payments.
HEDERA_MAX_PAYMENT_TINYBARS=
# Existing PAYMENTS_ENABLED=false above must be changed to true only after setup.

# Durable local service state. Never deploy this directory on ephemeral storage.
DATA_DIRECTORY=data/tmp/runtime
# CRE uses existing installed CLI/Bun; optional absolute binary paths:
# CRE_BIN=/absolute/path/to/cre
# BUN_BIN=/absolute/path/to/bun
# Optional per-provider, per-utility rates, integer tinybars for Hedera quotes.
# PROVIDER_A_UTILITY_RATES_JSON={"ERC20_TOKEN_METADATA":{"askMinor":"500","floorMinor":"300"},"SIMULATED_LINK_REPORT_WRITE":{"askMinor":"2000","floorMinor":"1200"}}
# PROVIDER_B_UTILITY_RATES_JSON={"ERC20_TOKEN_METADATA":{"askMinor":"700","floorMinor":"400"}}

# Arkiv Rabdi publication (server only). Name an existing local key variable,
# or use ARKIV_PRIVATE_KEY_ENV=ARKIV_PRIVATE_KEY and define that key locally.
ARKIV_PRIVATE_KEY_ENV=ARKIV_PRIVATE_KEY
ARKIV_PRIVATE_KEY=
ARKIV_PUBLISHER_ADDRESS=
ARKIV_TRUSTED_PUBLISHERS=
ARKIV_PUBLISHING_ENABLED=false
# Wei-denominated maximum publication fees; separate from Hedera spending caps.
ARKIV_MAX_TRANSACTION_FEE_WEI=100000000000000000
ARKIV_MAX_TOTAL_FEE_WEI=500000000000000000
ARKIV_ACCESS_KEY=
# ARKIV_JOURNAL_PATH=data/tmp/arkiv/publications.sqlite
# CRE_VERIFICATION_DIRECTORY=data/tmp/verification

# Connect the shared CRE/Arkiv adapters at gateway startup (requires local wallet above).
EVIDENCE_LAYER_ENABLED=false
# Enables 13 public Ethereum source reads and the live dashboard watch feed.
# Uses public RPC by default; no RPC API key is required.
PROVIDER_LINK_SOURCE_ENABLED=false
# Optional trusted operator RPC. Never supplied by a buyer or model.
# PROVIDER_ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# World Agent Pass OIDC. Register a sandbox client; keep its secret server-side.
# Enabled mode protects buyer leases, runs, streams, exports, and mutations.
# Without enabled mode this remains an unsecured local demo, not a private workspace.
WORLD_AUTH_ENABLED=false
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=http://127.0.0.1:3001/api/auth/world/callback
# Explicit loopback development exception only. Production requires HTTPS cookies.
WORLD_ALLOW_LOCAL_HTTP=false
WORLD_CLIENT_AUTH_METHOD=client_secret_basic

# Provider diversity. Each agent is a separate process with its own task tariffs.
PROVIDER_C_PORT=4103
# Optional independent merchant for Sage. Without this it can quote but cannot sell.
HEDERA_PROVIDER_C_ACCOUNT_ID=
# Direct Claude API, used automatically by Sage when this key is configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional per-agent model selection; other agents inherit COMPUTE_PROVIDER.
# PROVIDER_A_COMPUTE_PROVIDER=openrouter
# PROVIDER_B_OPENROUTER_MODEL=vendor/another-model:free
# PROVIDER_C_COMPUTE_PROVIDER=claude
# PROVIDER_C_ANTHROPIC_MODEL=claude-sonnet-5-5
# PROVIDER_C_UTILITY_RATES_JSON={"ERC20_TOKEN_METADATA":{"askMinor":"950","floorMinor":"650"}}
# PROVIDER_C_ETH_RPC_URL=https://eth.drpc.org

# Additional independent provider processes and optional merchant recipients.
PROVIDER_D_PORT=4104
PROVIDER_E_PORT=4105
PROVIDER_F_PORT=4106
HEDERA_PROVIDER_D_ACCOUNT_ID=
HEDERA_PROVIDER_E_ACCOUNT_ID=
HEDERA_PROVIDER_F_ACCOUNT_ID=
# PROVIDER_D_COMPUTE_PROVIDER=openrouter
# PROVIDER_E_COMPUTE_PROVIDER=claude
# PROVIDER_E_ANTHROPIC_MODEL=claude-haiku-5-5
# PROVIDER_F_COMPUTE_PROVIDER=0g
# PROVIDER_D_UTILITY_RATES_JSON={"AAVE_V3_USDC_SUPPLY_APY":{"askMinor":"550","floorMinor":"350"}}
