{
  "name": "Data Leases backend (gateway + provider agents)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.28.1 --activate && pnpm install --frozen-lockfile",
  "postStartCommand": "bash scripts/codespace-backend.sh start",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Data Leases gateway (public, for Vercel)", "onAutoForward": "silent" },
    "4101-4110": { "label": "provider agents (private)", "onAutoForward": "ignore" }
  },
  "secrets": {
    "PRIVY_APP_ID": { "description": "Privy app ID (same as NEXT_PUBLIC_PRIVY_APP_ID)" },
    "PRIVY_APP_SECRET": { "description": "Privy app secret (or set PRIVY_VERIFICATION_KEY)" },
    "WEB_ORIGINS": { "description": "Allowed web origins, e.g. https://data-leases.vercel.app" },
    "HEDERA_BUYER_ACCOUNT_ID": { "description": "Hedera testnet buyer account (testnet only)" },
    "HEDERA_BUYER_PRIVATE_KEY": { "description": "Hedera testnet buyer key (testnet only, never real funds)" },
    "OPENROUTER_API_KEY": { "description": "Optional: model suggestions" },
    "ANTHROPIC_API_KEY": { "description": "Optional: Claude for Sage/Beacon" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/CODESPACES.md"] }
  }
}
