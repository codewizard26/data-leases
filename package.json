{
  "name": "data-leases",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration packages/agents/tests/loop.test.ts",
    "demo:a2a": "tsx scripts/demo.ts",
    "dev:provider": "tsx apps/provider-agent/src/main.ts",
    "demo:buyer": "tsx apps/agent-gateway/src/buyer.ts",
    "dev": "node --env-file=.env --import tsx scripts/dev.ts",
    "cre:prepare": "pnpm --filter @data-leases/cre-adapter cre:prepare",
    "cre:simulate:services": "node --import tsx scripts/simulate-services.ts",
    "cre:prepare:services": "tsx scripts/prepare-services.ts",
    "cre:simulate": "pnpm --filter @data-leases/cre-adapter cre:simulate",
    "dev:web": "pnpm --filter @data-leases/web dev",
    "parquet:inspect": "tsx scripts/parquet-inspect.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "eslint": "9.39.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "3.2.4",
    "zod": "3.25.76",
    "@data-leases/contracts": "workspace:*",
    "@data-leases/cre-adapter": "workspace:*",
    "@data-leases/event-store": "workspace:*"
  },
  "type": "module"
}
